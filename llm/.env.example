# LLM gRPC Service - Environment Example

# gRPC server
LLM_GRPC_PORT=50051
LLM_GRPC_TOKEN=dev-secret-token

# Optional HTTP (not used in current server)
LLM_HTTP_PORT=8000

# FAISS vector store base directory
FAISS_INDEX_BASE=./faiss_indexes


# Optional: Google/other API keys if you extend functionality
# GOOGLE_API_KEY=
