# ===========================================
# Server Configuration
# ===========================================
PORT=8080
APP_ENV=local

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=backend_balkanid
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Alternative: Use single DATABASE_URL (e.g., Neon, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-strong-secret-key-change-in-production

# ===========================================
# Frontend URL (CORS)
# ===========================================
FRONTEND_URL=http://localhost:5173

# ===========================================
# Object Storage Configuration
# ===========================================
# Storage provider: "minio" or "azure"
STORAGE_PROVIDER=minio

# MinIO Configuration (Local Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filevault
MINIO_USE_SSL=false

# Azure Blob Storage Configuration (Production)
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_STORAGE_KEY=your-storage-account-key
AZURE_BLOB_CONTAINER=filevault

# ===========================================
# Redis Configuration
# ===========================================
# Local Redis (Docker)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_USE_SSL=false

# Upstash Redis (Cloud - optional)
# REDIS_URL=rediss://default:password@host:6379
# REDIS_ADDR=host:6379
# REDIS_PASSWORD=your-redis-password
# REDIS_USE_SSL=true

# ===========================================
# Kafka Configuration (Optional)
# ===========================================
KAFKA_BROKER=localhost:29092

# ===========================================
# Email (SMTP) Configuration
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Note: For Gmail, use App Passwords (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords

# ===========================================
# LLM Service Configuration (gRPC)
# ===========================================
LLM_GRPC_ADDR=127.0.0.1:50051
LLM_GRPC_PORT=50051
LLM_GRPC_TOKEN=dev-secret-token

# ===========================================
# Azure PostgreSQL (Alternative - Production)
# ===========================================
# DB_HOST=your-server.postgres.database.azure.com
# DB_PORT=5432
# DB_DATABASE=your-db-name
# DB_USERNAME=your-admin-user
# DB_PASSWORD=your-db-password
# DB_SSLMODE=require
