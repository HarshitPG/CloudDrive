# File Search schema

type FileSearchResult {
  id: ID!
  filename: String!
  mime: String!
  size: Int!
  createdAt: String!
  updatedAt: String!
  downloadCount: Int!
  contentHash: String!
  physicalSize: Int!
  refCount: Int!
  dedupSavings: Int!
  rank: Float
}

type FileSearchResponse {
  items: [FileSearchResult!]!
  total: Int!
  limit: Int!
  offset: Int!
}

type FolderSearchResult {
  id: ID!
  name: String!
  size: Int!
  createdAt: String!
  updatedAt: String!
  rank: Float
}

type CombinedSearchResponse {
  files: [FileSearchResult!]!
  folders: [FolderSearchResult!]!
  totalFiles: Int!
  totalFolders: Int!
  limit: Int!
  offset: Int!
}

type Query {
  searchFiles(
    q: String
    mime: String
    minSize: Int
    maxSize: Int
    dateFrom: String
    dateTo: String
    tags: [String!]
    uploader: String
    folderId: ID
    limit: Int
    offset: Int
    sort: String
  ): FileSearchResponse!

  # Search both files and folders. If folderId is provided, search only inside that folder.
  # If folderId is not provided, search in the root directory (top level) for both files and folders.
  searchItems(
    q: String
    folderId: ID
    limit: Int
    offset: Int
    sort: String
  ): CombinedSearchResponse!
}
